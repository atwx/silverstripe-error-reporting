{
    "name": "atwx/silverstripe-error-reporting",
    "description": "Report real errors of Silverstripe sites to Sentry/GlitchTip: errors and fatals only, noise filtered, one fingerprint per cause, tagged with site and installation",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "sentry", "glitchtip", "error reporting", "logging"],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^7.4 || ^8.0",
        "silverstripe/framework": "^4.10 || ^5.0 || ^6.0",
        "sentry/sentry": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "conflict": {
        "phptek/sentry": "*"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\ErrorReporting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\ErrorReporting\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
